# Define the Patient class
Patient <- setRefClass(
    "Patient",
    fields = list(
        id = "character",
        dataset = "character",
        site = "factor",
        age = "numeric",
        sex = "factor",
        diagnosis = "factor",
        ses = "character",
        img = "character",
        patient_data = "data.frame"
    ),
    methods = list(
        initialize = function(i, metadata) {
            id <<- metadata$subj_id[i]
            dataset <<- metadata$dataset[i]
            site <<- as.factor(metadata$site_string[i])
            age <<- metadata$age[i]
            sex <<- as.factor(metadata$sex_string[i])
            diagnosis <<- as.factor(metadata$diagnosis[i])
            ses <<- metadata$ses[i]
            
            if (is.na(ses)) {
                patient_dir <- file.path("/fs04/kg98/trangc/VBM/data", dataset, id, "anat")
                img <<- file.path(patient_dir, paste0("s6mwp1", id, "_T1w.nii"))
            } else {
                patient_dir <- file.path("/fs04/kg98/trangc/VBM/data", dataset, id, ses, "anat")
                img <<- file.path(patient_dir, paste0("s6mwp1", id, "_", ses, "_T1w.nii"))
            }
        },
        
        get_patient_voxels = function(atlas, nparcs = 66) {
            
            img_data <- readnii(img)
            gmv <- img_data@.Data
            
            mask <- (atlas > 0) & (atlas <= nparcs)
            gmv <- gmv[mask]
            
            gmv_flat <- as.vector(gmv)
            voxels <- setNames(gmv_flat, seq_along(gmv_flat))
            
            return(voxels)
        },
        
        make_patient_df = function(voxels) {
            n <- length(voxels)
            data <- tibble(
            MGV = as.double(voxels),
            subj_id = rep(id, n),
            voxel = as.factor(names(voxels)),
            diagnosis = rep(diagnosis, n),
            age = rep(age, n),
            sex = rep(sex, n),
            site = rep(site, n)
            )
            
            patient_data <<- data
        }
    )
)





# %% Load Base Data & Atlas
master_metadata <- read_csv("/fs04/kg98/trangc/VBM/data/metadataVBM.csv") %>%
    filter(!(subj_id %in% c("sub-6125CFO", "sub-7668IPT")))

s132_img <- readnii('/fs03/kg98/gchan/Atlases/Tian/Schaefer_Tian/reordered/Schaefer2018_100Parcels_7Networks_order_Tian_Subcortex_S2_MNI152NLin6Asym_1.5mm_reordered.nii.gz')
atlas <- s132_img@.Data

# Rebuild atlas coordinate mapping dataframe
nparcs <- 66
mask <- (atlas > 0) & (atlas <= nparcs)
atlas_masked_vector <- atlas[mask]
atlas_df <- data.frame(
    voxel = 1:length(atlas_masked_vector),
    ROI = atlas_masked_vector
)

# # Count voxels per ROI
# roi_counts <- atlas_df %>%
#     group_by(ROI) %>%
#     tally(name = "voxel_count")

# print("--- Voxel Counts per ROI ---")
# print(roi_counts, n = Inf)


# Initialize the final dataframe with all available unique ROIs
final_roi_summary <- data.frame(ROI = sort(unique(atlas_masked_vector)))

# Define target clinical groups
disorders <- c("ASD", "BD", "MDD", "SCA", "SCZ")

# %% Loop Through Each Disorder
for (dis in disorders) {
    message(paste("\n==== Processing disorder:", dis, "===="))
    
    # 1. Filter sites that contain BOTH Healthy Controls and the target disorder
    valid_sites <- master_metadata %>%
        group_by(site_string) %>%
        filter(any(diagnosis_string == "HC") & any(diagnosis_string == dis)) %>%
        pull(site_string) %>%
        unique()
    
    # Subset metadata and force "HC" to be the reference factor level
    sub_metadata <- master_metadata %>%
        filter(site_string %in% valid_sites, diagnosis_string %in% c("HC", dis)) %>%
        mutate(diagnosis = factor(diagnosis_string, levels = c("HC", dis)))
    
    if (nrow(sub_metadata) == 0) {
        message(paste("Skipping", dis, "- no matching subjects or overlapping sites found."))
        next
    }
    
    # 2. Extract voxel data for the current group subset
    pboptions(type = "timer")
    patient_dfs <- pblapply(seq_len(nrow(sub_metadata)), function(i) {
        patient <- Patient$new(i, sub_metadata)
        voxels <- patient$get_patient_voxels(atlas)
        patient$make_patient_df(voxels)
        return(patient$patient_data)
    })
    
    gmv_dis <- bind_rows(patient_dfs)
    
    # 3. Clean up site variances (drop sites with only 1 diagnosis type present in data)
    sites_to_remove <- gmv_dis %>%
        group_by(site) %>%
        filter(length(unique(diagnosis)) < 2) %>%
        pull(site)
    
    gmv_dis <- gmv_dis %>% filter(!site %in% sites_to_remove)
    voxels_dis <- split(gmv_dis, gmv_dis$voxel)
    
    # 4. Calculate LME beta values across voxels
    message(paste("Running LME models for", dis, "..."))
    beta_values <- pblapply(names(voxels_dis), function(voxel) {
        df_vox <- voxels_dis[[voxel]]
        
        # SAFEGUARD 1: Skip if total sample size is too low (e.g., < 20 subjects total)
        # or if a group has fewer than 5 subjects. Adjust these thresholds as needed.
        if (nrow(df_vox) < 20) return(NA_real_)
        
        group_counts <- table(df_vox$diagnosis)
        if (any(group_counts < 5)) return(NA_real_)
        
        # Fit model and silently ignore warnings
        model <- tryCatch(
            suppressMessages(suppressWarnings(
                lmer(MGV ~ diagnosis + age + sex + (1 | site), data = df_vox)
            )),
            error = function(e) NULL
        )
        
        if (is.null(model)) return(NA_real_)
        
        # Extract the diagnosis coefficient directly
        coef_name <- paste0("diagnosis", dis)
        if (coef_name %in% rownames(summary(model)$coefficients)) {
            return(summary(model)$coefficients[coef_name, "Estimate"])
        } else {
            return(NA_real_)
        }
    })
    
    beta_df_dis <- data.frame(
        voxel = as.integer(names(voxels_dis)),
        diagnosis_beta = as.numeric(unlist(beta_values))
    )
    
    # 5. Map voxels to ROIs and calculate mean group effects
    roi_summary_dis <- beta_df_dis %>%
        left_join(atlas_df, by = "voxel") %>%
        group_by(ROI) %>%
        summarize(
            mean_beta = mean(diagnosis_beta, na.rm = TRUE)
        )
    
    # Dynamically assign your desired output column name
    colnames(roi_summary_dis)[2] <- paste0(dis, "_corr")
    
    # 6. Merge result columns into your final dataframe
    final_roi_summary <- left_join(final_roi_summary, roi_summary_dis, by = "ROI")
}

# %% Output Results Table
print(head(final_roi_summary))
write.csv(final_roi_summary, "./results/multidisorder_betas_parc_2.csv", row.names = FALSE)








